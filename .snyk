# npm-only GHSA-3g3m-2fjr-6pw4: glob@9.3.5 remains under babel-plugin-module-resolver@5.0.3.
# Glob AbortSignal cancellation affects asynchronous traversal of attacker-controlled patterns.
# normalizeRoot() uses hasMagic()/sync() on repository-controlled Babel root paths, without AbortSignal.
# glob@14.0.3 is cooldown-eligible but its ESM default export is incompatible with this caller
# (production build and Jest fail with undefined hasMagic). Recheck upstream by 2026-12-05.
patch: {}
